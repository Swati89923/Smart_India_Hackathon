PORT=4000

# --- AI: Google Gemini (https://aistudio.google.com → Get API key) ---
# Used for: voice transcription (Hindi/English/mixed), product identification, bilingual catalogue.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: main model and comma-separated fallbacks used when a model is busy (503/429)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.5-flash

# --- Background removal: remove.bg (https://www.remove.bg/api) ---
REMOVE_BG_API_KEY=
# auto (best available) | preview (small, cheaper) | full
REMOVE_BG_SIZE=auto

# --- Image storage/CDN: Cloudinary (https://console.cloudinary.com → Dashboard) ---
# CLOUD NAME is the short id shown on the dashboard (e.g. dx3k9abcd), not your account/display name.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Production data layer (not used by the prototype yet; see src/db.js) ---
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F).
DATABASE_URL=postgres://user:password@localhost:5432/shilpsaathi

# --- Auth ---
JWT_SECRET=
ADMIN_EMAIL=admin@shilpsaathi.gov.in
ADMIN_PASSWORD=admin123
