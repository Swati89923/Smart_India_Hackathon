{
  "expo": {
    "name": "ShilpSaathi",
    "slug": "shilpsaathi",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.shilpsaathi.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "in.shilpsaathi.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "ShilpSaathi needs microphone access so you can describe products by voice."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ShilpSaathi needs camera access so you can photograph your products.",
          "photosPermission": "ShilpSaathi needs gallery access so you can choose product photos."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
